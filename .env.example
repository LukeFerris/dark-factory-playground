# Copy to .env and fill in. .env is git-ignored; never commit it.
# Values marked CHECKPOINT are produced by a manual step in docs/factory/SETUP.md.

GH_OWNER=LukeFerris
GH_REPO=dark-factory-playground

# CHECKPOINT A — GitHub App
FACTORY_APP_ID=
FACTORY_APP_KEY_PATH=./secrets/factory-app.pem
# The App's bot login, of the form <app-slug>[bot]. Recorded at Checkpoint A.
FACTORY_BOT_LOGIN=

# CHECKPOINT B — Jira Cloud
JIRA_BASE=https://<site>.atlassian.net
JIRA_USER=
JIRA_TOKEN=
JIRA_PROJECT_KEY=DF

# CHECKPOINT C — Anthropic
ANTHROPIC_API_KEY=

# CHECKPOINT E (optional) — real preview environments.
# Leave FACTORY_PREVIEW_BACKEND unset or `ghcr` for the stub, which needs none
# of the rest. `azure` runs one Azure Container App per PR; see SELF-HOSTING.md.
# In CI these are repository VARIABLES, not secrets — sign-in is by OIDC, so
# there is no Azure secret to store. AZURE_CLIENT_ID, AZURE_TENANT_ID and
# AZURE_SUBSCRIPTION_ID are read by azure/login in the workflow, not by the CLI.
FACTORY_PREVIEW_BACKEND=ghcr
AZURE_RESOURCE_GROUP=
AZURE_ACR_NAME=
AZURE_CONTAINERAPPS_ENVIRONMENT=
AZURE_PREVIEW_REPOSITORY=dark-factory-playground
# Optional; defaults to df. Keeps two factories sharing one environment apart.
AZURE_PREVIEW_PREFIX=
