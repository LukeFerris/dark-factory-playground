node_modules/
dist/
coverage/

# Never commit credentials.
.env
.env.local
secrets/

# Agent scratch space. The manuals and the generated schema ARE committed;
# the per-run input and output are not.
.agent/in/
.agent/out/

# Preview stub scratch.
.preview/

.DS_Store
*.log

# Terraform. The state names the app registration and the identity; it holds no
# secret (OIDC means there is none) but it is machine-local and not shared.
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider versions,
# and an unpinned provider can change what `apply` does with nobody watching.
infra/**/.terraform/
infra/**/terraform.tfstate
infra/**/terraform.tfstate.*
infra/**/*.tfvars
!infra/**/*.tfvars.example
